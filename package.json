  "bin": {
    "dsh-box": "bin/cli.js"
  },
  "files": ["bin", "src", "AGENTS.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node tools/check-all.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
